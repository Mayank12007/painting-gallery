{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gallerist-art-gallery-production.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://gallerist-art-gallery-production.up.railway.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
